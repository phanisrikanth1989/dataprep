{
  "case_id": "per_column_trim",
  "description": "Per-column trim via trim_columns config",
  "csv_content": "name,city\n  Alice  , New York \n  Bob  , London \n",
  "config": {
    "delimiter": ",",
    "trim_columns": [
      {"column": "name", "trim": "both"}
    ],
    "schema": [
      {"name": "name", "type": "string"},
      {"name": "city", "type": "string"}
    ]
  },
  "expected": {
    "main": {
      "name": ["Alice", "Bob"],
      "city": [" New York ", " London "]
    }
  }
}
