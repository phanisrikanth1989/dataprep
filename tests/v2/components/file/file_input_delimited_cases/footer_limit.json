{
  "case_id": "footer_and_limit",
  "description": "Footer skip (eager) + limit",
  "csv_content": "id,name\n1,A\n2,B\n3,C\n4,D\n5,E\n",
  "config": {
    "delimiter": ",",
    "footer_rows": 2,
    "limit": 2,
    "schema": [
      {"name": "id", "type": "integer"},
      {"name": "name", "type": "string"}
    ]
  },
  "expected": {
    "main": {
      "id": [1, 2],
      "name": ["A", "B"]
    }
  }
}
