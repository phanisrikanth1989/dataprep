{
  "description": "Append mode: second write appends without duplicate header",
  "config": {
    "path": "__TMP__/output.csv",
    "append": true
  },
  "input_data": {
    "id": [4, 5],
    "name": ["Dave", "Eve"]
  },
  "pre_existing_content": "id,name\n1,Alice\n2,Bob\n3,Charlie\n",
  "expected_output_contains": ["id,name", "1,Alice", "2,Bob", "3,Charlie", "4,Dave", "5,Eve"],
  "expected_header_count": 1
}
