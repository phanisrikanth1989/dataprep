{
    "description": "Filter with reject output: matched rows on main, rejected rows on reject",
    "config": {"condition": "amount > 100", "reject_output": true},
    "inputs": {
        "main": {
            "id": [1, 2, 3, 4],
            "amount": [50, 150, 100, 200]
        }
    },
    "expected": {
        "main": {
            "id": [2, 4],
            "amount": [150, 200]
        },
        "reject": {
            "id": [1, 3],
            "amount": [50, 100]
        }
    }
}
