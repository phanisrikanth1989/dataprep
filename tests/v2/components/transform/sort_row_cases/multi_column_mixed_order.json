{
    "case_id": "multi_column_mixed_order",
    "config": {
        "columns": [
            {"name": "category", "order": "asc"},
            {"name": "amount", "order": "desc"}
        ],
        "maintain_order": true
    },
    "inputs": {
        "main": {
            "category": ["B", "A", "B", "A", "C"],
            "amount": [200, 100, 300, 400, 150],
            "id": [1, 2, 3, 4, 5]
        }
    },
    "expected": {
        "main": {
            "category": ["A", "A", "B", "B", "C"],
            "amount": [400, 100, 300, 200, 150],
            "id": [4, 2, 3, 1, 5]
        }
    }
}
