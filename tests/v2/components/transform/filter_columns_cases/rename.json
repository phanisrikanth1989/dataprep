{
    "description": "Keep mode with column rename via source mapping",
    "config": {
        "columns": [
            {"name": "user_id", "source": "id"},
            {"name": "full_name", "source": "name"}
        ]
    },
    "inputs": {
        "main": {
            "id": [1, 2],
            "name": ["Alice", "Bob"],
            "amount": [100.0, 200.0]
        }
