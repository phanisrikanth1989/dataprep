{
  "name": "etl-studio",
  "displayName": "ETL Studio",
  "description": "Agent-authored RecTran jobs with the human in the loop.",
  "version": "0.0.1",
  "publisher": "citi-demo",
  "private": true,
  "engines": {
    "vscode": "^1.104.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "etlStudio.open",
        "title": "ETL Studio: Open"
      }
    ],
    "configuration": {
      "title": "ETL Studio",
      "properties": {
        "etlStudio.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to spawn the agent core. Empty = <repo>/.venv/bin/python if present, else python3 on PATH."
        },
        "etlStudio.provider": {
          "type": "string",
          "enum": [
            "auto",
            "vscode_lm",
            "double"
          ],
          "default": "auto",
          "description": "Provider adapter wired into the agent core. auto = vscode.lm when Copilot models exist, else the scripted test double (fallback is announced, never silent)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vscode-jsonrpc": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "1.104.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4"
  }
}
