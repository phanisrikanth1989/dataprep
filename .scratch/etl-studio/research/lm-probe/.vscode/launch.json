{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run LM Probe",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"]
    },
    {
      "name": "Run LM Probe (proposed API)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--enable-proposed-api=citi-demo.lm-probe"
      ]
    }
  ]
}
