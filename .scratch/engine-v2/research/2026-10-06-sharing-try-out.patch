diff --git a/src/v2/sharing.py b/src/v2/sharing.py
new file mode 100644
index 00000000..a008c1ec
--- /dev/null
+++ b/src/v2/sharing.py
@@ -0,0 +1,19 @@
+"""TRY-OUT for ticket 31, not for keeping: mark a frame that several readers share so that it is worked out once.
+
+V2_SHARE=off      nothing is marked: the engine as it is
+V2_SHARE=closed   cache() with a barrier behind it that lets nothing through (the default here)
+V2_SHARE=open     cache() with a barrier that lets column pruning through
+"""
+import os
+
+import polars as pl
+
+
+def shared(frame: pl.LazyFrame, readers: int = 2) -> pl.LazyFrame:
+    way = os.environ.get("V2_SHARE", "closed")
+    if readers < 2 or way == "off":
+        return frame
+    return frame.cache().map_batches(
+        lambda batch: batch, streamable=True, validate_output_schema=False,
+        projection_pushdown=way == "open", predicate_pushdown=False, slice_pushdown=False,
+    )
