    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="total_amount" expression="orders.quantity  * orders.unit_price " type="id_Double"/>
        <mapperTableEntries name="is_vip" expression="OrderManagement.isVip(Var.total_amount, context.vip_threshold)" type="id_Boolean"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="enriched_orders">
        <mapperTableEntries name="order_id" expression="orders.order_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="customer_id" expression="orders.customer_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="customer_name" expression="customers.customer_name " type="id_String" nullable="true"/>
        <mapperTableEntries name="email" expression="customers.email " type="id_String" nullable="true"/>
        <mapperTableEntries name="city" expression="customers.city " type="id_String" nullable="true"/>
        <mapperTableEntries name="segment" expression="customers.segment " type="id_String" nullable="true"/>
        <mapperTableEntries name="product_id" expression="orders.product_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="product_name" expression="products.product_name " type="id_String" nullable="true"/>
        <mapperTableEntries name="category" expression="products.category " type="id_String" nullable="true"/>
        <mapperTableEntries name="quantity" expression="orders.quantity " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="unit_price" expression="orders.unit_price " type="id_Double" nullable="true"/>
        <mapperTableEntries name="total_amount" expression="routines.OrderManagement.orderTotal(orders.quantity, orders.unit_price)" type="id_Double" nullable="true"/>
        <mapperTableEntries name="order_date" expression="orders.order_date " type="id_Date" nullable="true"/>
        <mapperTableEntries name="is_vip" expression="Var.is_vip " type="id_Boolean" nullable="true"/>
      </outputTables>
      <outputTables sizeState="INTERMEDIATE" name="vip_orders" expressionFilter="Var.is_vip " activateExpressionFilter="true">
        <mapperTableEntries name="order_id" expression="orders.order_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="customer_name" expression="customers.customer_name " type="id_String" nullable="true"/>
        <mapperTableEntries name="total_amount" expression="Var.total_amount " type="id_Double"/>
      </outputTables>
      <inputTables sizeState="INTERMEDIATE" name="orders" expressionFilter="&quot;COMPLETED&quot;.equals(orders.status) " activateExpressionFilter="true" matchingMode="UNIQUE_MATCH" lookupMode="LOAD_ONCE">
